{
  "name": "@andrei.fyi/auto",
  "version": "0.0.0-semantic-release",
  "repository": "https://github.com/3rd/auto",
  "description": "Powerful TypeScript-based automation tool",
  "keywords": [
    "typescript",
    "cli",
    "automation"
  ],
  "author": {
    "name": "Andrei Neculaesei",
    "email": "3rd@users.noreply.github.com"
  },
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/main.mjs",
  "exports": {
    "./loader-esm": {
      "import": "./dist/loader-esm.mjs"
    },
    "./loader-cjs": {
      "require": "./dist/loader-cjs.cjs"
    },
    "./globals": {
      "import": "./dist/globals/index.mjs",
      "types": "./dist/globals/index.d.ts"
    }
  },
  "bin": {
    "auto": "./dist/main.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm test:watch",
    "build:watch": "pkgroll --watch",
    "build": "pnpm run clean && pkgroll --target=node22",
    "test": "NODE_OPTIONS='--import=tsx --no-warnings' ava",
    "test:watch": "NODE_OPTIONS='--import=tsx --no-warnings' ava --watch",
    "e2e": "docker run --rm -it $(docker build -f src/e2e/Dockerfile -q .)",
    "tsc": "tsc",
    "prepare": "husky",
    "prepublishOnly": "pnpm run build && pnpm run tsc && pnpm run test",
    "clean": "rm -rf dist"
  },
  "ava": {
    "extensions": [
      "ts"
    ]
  },
  "lint-staged": {
    "*": "prettier --ignore-unknown --write"
  },
  "prettier": {
    "arrowParens": "always",
    "bracketSpacing": true,
    "printWidth": 120,
    "quoteProps": "as-needed",
    "semi": true,
    "singleQuote": false,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.0",
    "@commitlint/config-conventional": "^21.2.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/node": "^22.20.0",
    "@types/sinon": "^22.0.0",
    "ava": "^8.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "pkgroll": "^2.27.1",
    "prettier": "^3.9.4",
    "semantic-release": "^25.0.5",
    "sinon": "^22.0.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.5.2",
    "@types/cross-spawn": "^6.0.6",
    "@types/fs-extra": "^11.0.4",
    "@types/lodash": "^4.17.24",
    "@types/which": "^3.0.4",
    "chalk": "^5.6.2",
    "cross-spawn": "^7.0.6",
    "env-paths": "^4.0.0",
    "execa": "^9.6.1",
    "find-up": "^8.0.0",
    "fs-extra": "^11.3.6",
    "glob": "^13.0.6",
    "gunsmith": "^0.6.0",
    "lodash": "^4.18.1",
    "tsx": "^4.23.0",
    "which": "^4.0.0",
    "zod": "^4.4.3"
  }
}
